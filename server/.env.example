# =====================================================
# APPLE BLOSSOM - SERVER ENV EXAMPLE (STEP 4)
# =====================================================
# Copy this file to ".env" and fill real values.
#   cp .env.example .env
#
# Step 4 ke saare providers optional hain:
#   - configure na ho to message log me "skipped" aata hai
#   - server kabhi crash nahi hota
# =====================================================

# -------------------------------
# SERVER
# -------------------------------
PORT=4000
FRONTEND_URL=http://localhost:5173
STORE_NAME=Apple Blossom

# -------------------------------
# DATABASE
# -------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=appleblossom

# -------------------------------
# JWT
# -------------------------------
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# -------------------------------
# EMAIL (Gmail OAuth2) - Feature 7
# -------------------------------
NOTIFY_EMAIL_ENABLED=true
EMAIL_FROM_NAME=Apple Blossom
SUPPORT_EMAIL=you@gmail.com

EMAIL_USER=you@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# -------------------------------
# SMS (Feature 7)
# provider = none | twilio | msg91
# -------------------------------
SMS_PROVIDER=none

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ABLSSM
MSG91_ROUTE=4
MSG91_COUNTRY_CODE=91

# -------------------------------
# WHATSAPP (Feature 7)
# provider = none | meta | twilio
# -------------------------------
WHATSAPP_PROVIDER=none

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Twilio WhatsApp
TWILIO_WHATSAPP_FROM=

# -------------------------------
# ADMIN ALERTS
# -------------------------------
ADMIN_NOTIFICATION_EMAIL=you@gmail.com
ADMIN_NOTIFICATION_PHONE=

# -------------------------------
# SHIPPING (Feature 4 & 5)
# provider = manual | shiprocket
# -------------------------------
SHIPPING_PROVIDER=manual
DEFAULT_COURIER_NAME=Delhivery
DEFAULT_COURIER_CODE=delhivery
PUBLIC_TRACKING_BASE=
DEFAULT_PACKAGE_WEIGHT_GRAMS=500

# Shiprocket (provider=shiprocket hone par zaroori)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_CHANNEL_ID=
PICKUP_POSTCODE=152128
PICKUP_CITY=Abohar
PICKUP_STATE=Punjab
PICKUP_COUNTRY=India
PICKUP_ADDRESS=Apple Blossom Store
PICKUP_PHONE=0000000000

# -------------------------------
# RETURNS (Feature 1 & 2)
# -------------------------------
RETURN_WINDOW_DAYS=7

# -------------------------------
# INVOICE / STORE DETAILS (Feature 6)
# -------------------------------
STORE_ADDRESS=Main Market
STORE_CITY=Abohar
STORE_STATE=Punjab
STORE_PINCODE=152128
STORE_COUNTRY=India
STORE_PHONE=0000000000
STORE_GSTIN=
STORE_WEBSITE=

# -------------------------------
# PAYMENTS (Razorpay - refund ke liye)
# -------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
